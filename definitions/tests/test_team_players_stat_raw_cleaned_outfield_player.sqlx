config {
  type: "test",
  dataset: "team_players_stat_raw_cleaned"
}

-- Outfield player: numeric stats are cast, no goalkeeper stats ("-").
input "team_players_stat_raw" {
  SELECT
    "France" AS nationality,
    "4" AS goalsScored,
    "2" AS assistsProvided,
    "1.50" AS dribblesPerNinety,
    "7" AS appearances,
    "2.10" AS totalDuelsWonPerNinety,
    "0.30" AS interceptionsPerNinety,
    "0.80" AS tacklesPerNinety,
    "Nike" AS brandSponsorAndUsed,
    "PSG" AS club,
    "-" AS savePercentage,
    4 AS fifaRanking,
    "FW" AS position,
    "Kylian Mbappe" AS playerName,
    "-" AS cleanSheets,
    "Nike" AS nationalTeamKitSponsor,
    10 AS nationalTeamJerseyNumber,
    "Dec 20, 1998" AS playerDob
}

SELECT
  "France" AS nationality,
  4 AS goalsScored,
  2 AS assistsProvided,
  1.5 AS dribblesPerNinety,
  7 AS appearances,
  2.1 AS totalDuelsWonPerNinety,
  0.3 AS interceptionsPerNinety,
  0.8 AS tacklesPerNinety,
  "Nike" AS brandSponsorAndUsed,
  "PSG" AS club,
  "-" AS savePercentage,
  FALSE AS isGoalKeeperStatsExist,
  4 AS fifaRanking,
  "FW" AS position,
  "Kylian Mbappe" AS playerName,
  "-" AS cleanSheets,
  "Nike" AS nationalTeamKitSponsor,
  10 AS nationalTeamJerseyNumber,
  "Dec 20, 1998" AS playerDob
